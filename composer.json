{
    "name": "alexis-gss/laravel-activity-logs",
    "description": "Log activities on models in Laravel project.",
    "type": "library",
    "license": "MIT",
    "version": "3.0.0",
    "authors": [
        {
            "name": "Alexis Gousseau",
            "homepage": "https://alexis-gousseau.com",
            "role": "Developer"
        }
    ],
    "keywords": [
        "alexis-gss",
        "laravel",
        "activity-logs"
    ],
    "readme": "https://github.com/alexis-gss/laravel-activity-logs/blob/master/README.md",
    "support": {
        "issues": "https://github.com/alexis-gss/laravel-activity-logs/issues"
    },
    "require": {
        "php": "^8.5",
        "illuminate/support": "~13",
        "laravel/framework": "~13",
        "alexis-gss/laravel-backend": "^1.0",
        "alexis-gss/laravel-frontend": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "slevomat/coding-standard": "^8.3",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "LaravelActivityLogs\\": "src/"
        }
    },
    "scripts": {
        "phpcs": [
            "./vendor/bin/phpcs"
        ],
        "phpstan": [
            "./vendor/bin/phpstan"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelActivityLogs\\ActivityLogsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
